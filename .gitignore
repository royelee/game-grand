node_modules
dist
test-results/
playwright-report/
# SQLite project stores. The named files are the defaults, but the server
# takes DB_FILE from the environment, so match any SQLite file rather than
# trusting a filename — one committed database publishes every saved game.
*.db
*.db-*
*.sqlite
*.sqlite-*

# Generated by `make catalog` from scratch-gui's library JSONs, which are
# AGPL-3.0. Not committed, so this project's own license stays unentangled —
# see public/library/LICENSE.md.
public/library/scratch-catalog.json

# Deployment credentials. scripts/deploy.sh reads CLOUDFLARE_API_TOKEN from
# here. This repository is public: a token committed once is a token someone
# else deploys with, and rewriting history does not un-leak it.
.env
.env.*
!.env.example

# Wrangler's local state, including the local D1 database that `wrangler dev
# --local` writes real project documents into. Same reasoning as projects.db.
.wrangler/

# Compiled Electron main process. desktop/ is the one directory that emits —
# Electron runs its own bundled Node, which cannot be assumed to strip types
# the way `make server` relies on.
desktop/dist/
