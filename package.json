{
  "name": "game-grand",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "preview": "vite preview",
    "test:e2e:preview": "E2E_PREVIEW=1 playwright test",
    "test:e2e:server": "E2E_SERVER=1 playwright test",
    "catalog": "node scripts/build-scratch-catalog.ts",
    "server": "node server/index.ts",
    "server:dev": "node --watch server/index.ts",
    "typecheck:server": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@monaco-editor/react": "^4.7.0",
    "fastify": "^5.11.3",
    "monaco-editor": "^0.52.2",
    "phaser": "^3.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
