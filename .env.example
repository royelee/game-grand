# Copy to .env and fill in. .env is gitignored — never commit it.
#
# Create the token at https://dash.cloudflare.com/profile/api-tokens using a
# custom token scoped to this account only:
#
#   Account | Workers Scripts | Edit
#   Account | D1              | Edit
#
# Nothing else. A leaked token should be able to redeploy this Worker and
# nothing more — not touch DNS, other zones, or billing.
CLOUDFLARE_API_TOKEN=

# Optional. Only needed if your token can see more than one account.
CLOUDFLARE_ACCOUNT_ID=
